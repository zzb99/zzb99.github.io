---
const { article, featured = false } = Astro.props;
const date = article.data.pubDate.toLocaleDateString('zh-CN', { year:'numeric', month:'long', day:'numeric' });
---
<a class:list={['article-card', { 'article-card--featured': featured }]} href={`/articles/${article.data.slug}/`}><span>{featured ? '重点阅读 · ' : ''}{article.data.category} · {date}</span><h3>{article.data.title}</h3><p>{article.data.description}</p><b>阅读全文 <i>→</i></b></a>
