---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingVisual from '../../components/ReadingVisual.astro';
import '../../styles/reading-detail.css';
export async function getStaticPaths() { const articles = await getCollection('articles'); return articles.map(article => ({ params: { slug: article.data.slug }, props: { article } })); }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const linkedProject = article.data.relatedProject
  ? (await getCollection('projects')).find((project) => project.data.slug === article.data.relatedProject)
  : undefined;
const visual = article.data.hero ?? linkedProject?.data.hero;
const titleParts = article.data.title.match(/^(2026 AI 时间线·\d+)[：:](.*)$/);
const visualCaption = article.data.hero ? article.data.title : linkedProject ? `相关项目 · ${linkedProject.data.title}` : '从问题出发，沿着章节继续阅读。';
const visualAlt = article.data.hero ? article.data.title : linkedProject ? `${linkedProject.data.title}配图` : '水面、远山与简洁建筑';
const articles = (await getCollection('articles')).sort((a,b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const sameTitle = articles.filter(item => item.id !== article.id && item.data.title === article.data.title);
const index = articles.findIndex(item => item.id === article.id);
const previous = articles[index - 1]; const next = articles[index + 1];
const related = articles.filter(item => item.id !== article.id && item.data.title !== article.data.title && (item.data.category === article.data.category || item.data.relatedProject === article.data.relatedProject)).slice(0, 2);
const date = article.data.pubDate.toLocaleDateString('zh-CN', { year:'numeric', month:'long', day:'numeric' });
const updatedDate = (article.data.updatedDate ?? article.data.pubDate).toLocaleDateString('zh-CN', { year:'numeric', month:'long', day:'numeric' });
const toBytedanceTime = (value: Date) => `${value.toISOString().slice(0, 10)}T00:00:00+08:00`;
const publishedTime = toBytedanceTime(article.data.pubDate);
const bytedanceUpdatedTime = toBytedanceTime(article.data.updatedDate ?? article.data.pubDate);
const hanCharacters = article.body.match(/[\p{Script=Han}]/gu)?.length ?? 0;
const latinWords = article.body.match(/[A-Za-z0-9]+/g)?.length ?? 0;
const readingMinutes = Math.max(1, Math.ceil(hanCharacters / 350 + latinWords / 220));
const url = new URL(`/articles/${article.data.slug}/`, Astro.site).href;
const structuredData = [{ '@context':'https://schema.org', '@type':'Article', headline: article.data.title, description: article.data.description, datePublished: article.data.pubDate.toISOString(), dateModified: (article.data.updatedDate ?? article.data.pubDate).toISOString(), mainEntityOfPage: url, author: { '@id': new URL('/#person', Astro.site).href }, image: article.data.hero ? new URL(article.data.hero, Astro.site).href : undefined }, { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem', position:1, name:'首页', item:Astro.site },{ '@type':'ListItem', position:2, name:'文章', item:new URL('/articles/', Astro.site).href },{ '@type':'ListItem', position:3, name:article.data.title, item:url }] }];
---
<BaseLayout title={article.data.seoTitle ?? `${article.data.title}｜张智博`} description={article.data.seoDescription ?? article.data.description} image={article.data.hero} ogImageAlt={article.data.title} type="article" structuredData={structuredData} publishedTime={publishedTime} updatedTime={bytedanceUpdatedTime}>
  <article class="article-page reading-page">
    <div class="reading-main">
    <a class="reading-back" href="/articles/"><span aria-hidden="true">←</span> 全部文章</a>
    <header class="reading-header">
      {titleParts && <p class="eyebrow">{titleParts[1]}</p>}<h1>{titleParts?.[2] ?? article.data.title}</h1>
      <p class="meta"><time datetime={article.data.pubDate.toISOString()}>{date}</time><a href="/about/">张智博</a><span>{article.data.category}</span><span>约 {readingMinutes} 分钟阅读</span>{updatedDate !== date && <span>更新于 <time datetime={(article.data.updatedDate ?? article.data.pubDate).toISOString()}>{updatedDate}</time></span>}</p>
      <p class="lead">{article.data.description}</p>{sameTitle.length > 0 && <p class="reading-version">同题记录：{sameTitle.map(item => <a href={`/articles/${item.data.slug}/`}>{item.data.pubDate.toLocaleDateString('zh-CN')} 发布的文章 →</a>)}</p>}
    </header>
    {tocHeadings.length > 0 && <details class="article-toc-mobile"><summary>文章目录 <span>{tocHeadings.length} 节</span></summary><nav aria-label="文章目录">{tocHeadings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav></details>}
    <div class="article-body-layout">
      <div class="article-content">
        <div class="prose"><Content /></div>
        {article.data.relatedProject && <p class="related-note">相关项目：<a class="text-link" href={`/projects/${article.data.relatedProject}/`}>查看项目档案 <i>→</i></a></p>}
        {related.length > 0 && <section class="article-related"><p class="eyebrow">RELATED WRITING</p><h2>相关文章</h2><div>{related.map(item => <a href={`/articles/${item.data.slug}/`}>{item.data.title} <i>→</i></a>)}</div></section>}
        <aside class="article-author"><b>张智博</b><span>保持好奇，也保持探索。记录项目、成果与仍在形成的思考。</span></aside>
        <nav class="article-neighbors" aria-label="文章导航">{previous?<a href={`/articles/${previous.data.slug}/`}>← {previous.data.title}</a>:<span />}{next&&<a href={`/articles/${next.data.slug}/`}>{next.data.title} →</a>}</nav>
        <p><a class="text-link" href="/articles/">返回文章列表 <i>→</i></a></p>
      </div>
    </div>
    </div>
    <ReadingVisual image={visual} alt={visualAlt} caption={visualCaption} outline={tocHeadings} />
  </article>
</BaseLayout>
<script>
  const allTocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.article-toc-mobile a')];
  const mobileToc = document.querySelector<HTMLDetailsElement>('.article-toc-mobile');
  allTocLinks.forEach((link) => link.addEventListener('click', () => mobileToc?.removeAttribute('open')));
</script>
