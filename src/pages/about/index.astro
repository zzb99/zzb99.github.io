---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aboutProfile } from '../../data/about-profile';
import { siteProfile } from '../../data/site';
import { programCredits, publicSources } from '../../data/media';
import { profileLastUpdated } from '../../data/profile-page';
import '../../styles/about-profile.css';

const pageUrl = new URL('/about/', Astro.site).href;
const personId = new URL('/#person', Astro.site).href;
const biography = aboutProfile.bio.slice(1);
const materialGroups = [
  {
    title: '代码与系统',
    description: '公开仓库可用于查看软件结构和本地运行方式。',
    items: aboutProfile.materials.filter((material) => material.source === 'GitHub'),
  },
  {
    title: '竞赛名单',
    description: '用于核对中国国际大学生创新大赛的公开获奖名单与赛道附件。',
    items: aboutProfile.materials.filter((material) => material.source === '教育部' || material.source === '中国国际大学生创新大赛官网'),
  },
  {
    title: '学校项目与获奖公示',
    description: '用于核对学校公开的项目介绍、团队信息与竞赛获奖记录。',
    items: aboutProfile.materials.filter((material) => material.source === '石家庄邮电职业技术学院'),
  },
];
const person = {
  '@type': 'Person', '@id': personId, name: siteProfile.name, alternateName: 'Zhibo Zhang', url: Astro.site,
  description: '张智博个人公开档案，记录其教育背景、智能分拣机器人、非遗数字化、酒店产品创新、竞赛荣誉和知识产权成果。',
  alumniOf: { '@type': 'CollegeOrUniversity', name: '石家庄邮电职业技术学院' },
  worksFor: { '@type': 'Organization', name: '中国邮政西安邮区中心' },
  knowsAbout: siteProfile.knowsAbout,
  sameAs: siteProfile.sameAs,
  ...(aboutProfile.portrait.src ? { image: new URL(aboutProfile.portrait.src, Astro.site).href } : {}),
};
const structuredData = {
  '@context': 'https://schema.org', '@graph': [
    person,
    { '@type': 'AboutPage', '@id': `${pageUrl}#about`, url: pageUrl, name: '关于张智博｜个人经历、代表项目与公开成果', dateModified: profileLastUpdated, mainEntity: { '@id': personId } },
    { '@type': 'ProfilePage', '@id': `${pageUrl}#profile`, url: pageUrl, name: '关于张智博｜个人经历、代表项目与公开成果', dateModified: profileLastUpdated, mainEntity: { '@id': personId } },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).href }, { '@type': 'ListItem', position: 2, name: '人物档案', item: pageUrl }] },
    { '@type': 'FAQPage', mainEntity: aboutProfile.faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
  ],
};
---
<BaseLayout title="关于张智博｜个人经历、代表项目与公开成果" description="张智博个人公开档案，记录其教育背景、全栈开发、智能分拣、节目后期、产品创新与可核对的项目成果。" structuredData={structuredData} includeBasePerson={false} updatedTime={profileLastUpdated}>
  <article class="public-profile" id="person">
    <nav class="profile-breadcrumb" aria-label="面包屑"><a href="/">首页</a> / 人物档案</nav>
    <header class="profile-hero"><div><p class="profile-eyebrow">ABOUT / 张智博</p><h1>让作品成为介绍。</h1><p class="profile-lead">把问题做成系统、产品与内容，再让过程和出处说明每一步。</p></div></header>
    <div class="profile-intro"><div class="profile-intro__copy"><p>张智博，石家庄邮电职业技术学院会计学院大数据与财务管理专业毕业生，现工作于中国邮政西安邮区中心。</p><p>从编程出发，连接产品、内容与真实业务。负责土族盘绣数字素材平台的需求与全栈开发，参与智能分拣和文化数字化项目，并担任“净界”项目负责人。</p><p>相关团队项目连续两年获得中国国际大学生创新大赛全国总决赛铜奖。他也参与节目后期制作，具体署名与原始来源见下方。</p></div><figure class="profile-portrait profile-portrait--below">{aboutProfile.portrait.src ? <img src={aboutProfile.portrait.src} alt={aboutProfile.portrait.alt} width="1086" height="1448" loading="eager" fetchpriority="high" /> : <div class="profile-portrait__placeholder" role="img" aria-label="张智博个人肖像照片待补充">肖像照片<br /><span>待本人提供</span></div>}<figcaption>{aboutProfile.portrait.src ? aboutProfile.portrait.caption : '人物照片待补充。图片由张智博本人提供。'}</figcaption></figure></div>
    <section class="profile-section" aria-labelledby="timeline-title"><header><h2 id="timeline-title">关键经历</h2><p class="profile-section__note">仅保留与公开项目和工作相关的节点。</p></header><ol class="profile-timeline">{aboutProfile.timeline.map(([year, text]) => <li><time>{year}</time><span>{text}</span></li>)}</ol></section>
    <section class="profile-section" aria-labelledby="projects-title"><header><h2 id="projects-title">代表项目与本人职责</h2><p class="profile-section__note">项目整体成果与个人实际承担的工作分别说明。</p></header><div class="profile-projects">{aboutProfile.projects.map((project) => <article class="profile-project"><h3>{project.title}</h3><span class="profile-project__label">本人职责</span><p>{project.role}</p><span class="profile-project__label">边界说明</span><p class="profile-project__boundary">{project.boundary}</p><a class="profile-link" href={project.href}>查看项目记录 →</a></article>)}</div></section>
    <section class="profile-section" aria-labelledby="public-work-title"><header><h2 id="public-work-title">影像署名与人物资料</h2><p class="profile-section__note">节目职务按原页逐条列示，人物条目作为公开索引。</p></header><div class="profile-public-work">{programCredits.map((item) => <a href={item.href} target="_blank" rel="noopener noreferrer"><span>《{item.series}》</span><strong>{item.credit} · 张智博</strong><small>查看本期节目原页 ↗</small></a>)}</div><p class="profile-public-work__source"><a href={publicSources.find((item) => item.id === 'baidu-baike')?.href} target="_blank" rel="noopener noreferrer">百度百科 · 张智博人物条目 ↗</a><span>条目用于检索；成果以本页所列原始来源为准。</span></p></section>
<details class="profile-archive"><summary>基础资料</summary>    <section class="profile-section" aria-labelledby="facts-title"><header><h2 id="facts-title">人物档案</h2><p class="profile-section__note">公开信息以可核验的教育、项目、竞赛与实践记录为主。</p></header><dl class="profile-facts">{aboutProfile.facts.map(([term, description]) => <div><dt>{term}</dt><dd>{description}</dd></div>)}</dl></section>
</details>
<details class="profile-archive"><summary>完整经历</summary>    <section class="profile-section" aria-labelledby="bio-title"><header><h2 id="bio-title">人物简介</h2></header><div class="profile-bio">{biography.map((paragraph) => <p>{paragraph}</p>)}</div></section>
</details>
<details class="profile-archive"><summary>公开成果与边界</summary>    <section class="profile-section" aria-labelledby="outcomes-title"><header><h2 id="outcomes-title">公开成果</h2><p class="profile-section__note">竞赛荣誉按团队项目记录表述；申请材料不等同于授权专利。</p></header><dl class="profile-outcomes">{aboutProfile.outcomes.map(([term, description]) => <div><dt>{term}</dt><dd>{description}</dd></div>)}</dl></section>
</details>
<details class="profile-archive"><summary>资料与出处</summary>    <section class="profile-section" aria-labelledby="materials-title"><header><h2 id="materials-title">公开资料</h2></header><p class="profile-material-intro">以下资料来自教育部、中国国际大学生创新大赛官网及石家庄邮电职业技术学院的公开页面，用于核对相关项目与竞赛结果。</p><div class="profile-material-groups">{materialGroups.map((group) => <section class="profile-material-group"><header><h3>{group.title}</h3><p>{group.description}</p></header><div class="profile-materials">{group.items.map((material) => <article class="profile-material"><small>{material.source}</small><h4><a href={material.href} target="_blank" rel="noopener noreferrer">{material.title}</a></h4><p>{material.description}</p></article>)}</div></section>)}</div></section>
</details>
<details class="profile-archive"><summary>常见问题</summary>    <section class="profile-section" aria-labelledby="faq-title"><header><h2 id="faq-title">常见问题</h2></header><div class="profile-faq">{aboutProfile.faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
</details>
    <footer class="profile-closing"><p>把复杂问题，做成可运行、可验证、可传播的作品。</p><p>如果你正在推进一个具体项目，欢迎从问题和约束开始谈。</p><nav class="profile-actions" aria-label="相关入口"><a class="profile-link" href="/profile/zhang-zhibo/">查看人物资料 →</a><a class="profile-link" href="/projects/">查看项目 →</a><a class="profile-link" href="/media/">影像与资料 →</a><a class="profile-link" href="/achievements/">成果记录 →</a><a class="profile-link" href="mailto:zzb9999@outlook.com?subject=%E9%A1%B9%E7%9B%AE%E5%90%88%E4%BD%9C%E4%BA%A4%E6%B5%81">洽谈项目 →</a></nav></footer>
  </article>
</BaseLayout>
