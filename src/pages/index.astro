---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { faqItems, siteProfile } from '../data/site';
import { homeConfig } from '../data/workbench';
import { achievementRecords, featuredAchievement } from '../data/achievements';
import { programCredits } from '../data/media';
import '../styles/home-page.css';

const allProjects = await getCollection('projects');
const projects = homeConfig.featuredProjectSlugs.map((slug) => allProjects.find((project) => project.data.slug === slug)).filter((project): project is NonNullable<typeof project> => Boolean(project));
const featuredProject = allProjects.find((project) => project.data.slug === 'panxiu-material-library');
const allArticles = (await getCollection('articles')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const articles = homeConfig.featuredArticleSlugs.length > 0
  ? homeConfig.featuredArticleSlugs.map((slug) => allArticles.find((article) => article.data.slug === slug)).filter((article): article is NonNullable<typeof article> => Boolean(article)).slice(0, 3)
  : allArticles.slice(0, 3);
const timeline = ['innovation-2024', 'innovation-2025', 'challenge-cup-2026'].map((id) => achievementRecords.find((record) => record.id === id)).filter((record): record is NonNullable<typeof record> => Boolean(record));
const structuredData = [{
  '@context': 'https://schema.org', '@type': 'WebSite', name: siteProfile.siteName, alternateName: siteProfile.brandName,
  url: Astro.site, description: siteProfile.description, inLanguage: 'zh-CN',
  author: { '@id': new URL('/#person', Astro.site).href },
}, {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
}];
---
<BaseLayout title="张智博｜技术、内容与真实业务" description={siteProfile.description} structuredData={structuredData} isHome>
  <meta slot="head" name="shenma-site-verification" content="1f22379207ad6c540ae8ecd788cafeff_1785080201" />
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__inner">
      <div class="home-hero__story">
        <p class="home-hero__eyebrow">ZHANG ZHIBO <span> / </span> {homeConfig.hero.subtitle}</p>
        <h1 id="home-title">{homeConfig.hero.name}<span class="home-hero__period">.</span></h1>
        <p class="home-hero__thesis">{homeConfig.hero.copy}</p>
        <p class="home-hero__description">从编程出发，连接产品、内容与真实业务。我关心的不只是一个想法是否精彩，更是它能否被做出来、被使用、被看见。</p>
        <div class="home-hero__actions"><a href="#selected-work">{homeConfig.hero.projectsLabel} <span aria-hidden="true">↘</span></a><a href="mailto:zzb9999@outlook.com?subject=%E9%A1%B9%E7%9B%AE%E5%90%88%E4%BD%9C%E4%BA%A4%E6%B5%81">谈一个项目 <span aria-hidden="true">↗</span></a></div>
        <a class="home-hero__reading" href="/articles/">{homeConfig.hero.articlesLabel} ↗</a>
        <p class="home-hero__index">01 / 05 <span>SCROLL TO EXPLORE</span></p>
      </div>
      <a class="home-hero__proof" href="/projects/panxiu-material-library/" aria-label="查看土族盘绣开放素材平台技术案例">
        <div class="home-hero__proof-top"><span>FEATURED BUILD</span><span>2026 · OPEN SOURCE</span></div>
        {featuredProject && <img src={featuredProject.data.hero} width="1200" height="760" alt="土族盘绣开放素材平台系统结构图" loading="eager" fetchpriority="high" />}
        <div class="home-hero__proof-bottom"><div><small>01 / TECHNOLOGY</small><strong>土族盘绣开放素材平台</strong><p>前台、管理后台、接口与数据库的一体化实现</p></div><span aria-hidden="true">↗</span></div>
      </a>
    </div>
    <a class="home-hero__scroll" href="#selected-work">向下探索 <span aria-hidden="true">↓</span></a>
  </section>

  <section id="selected-work" class="section home-work" aria-labelledby="selected-work-title">
    <div class="section-heading home-section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2 id="selected-work-title">{homeConfig.sections.projectsTitle}</h2></div><p>{homeConfig.sections.projectsCopy}</p></div>
    <div class="home-work__list">{projects.map((project, index) => <a class:list={['home-work__item', { 'home-work__item--lead': index === 0 }]} href={'/projects/' + project.data.slug + '/'}>
      <span class="home-work__index">{String(index + 1).padStart(2, '0')}</span>
      <div class="home-work__text"><p>{project.data.category} <span>·</span> {project.data.year}</p><h3>{project.data.title}</h3><span>{project.data.summary}</span></div>
      {index === 0 && <div class="home-work__visual"><img src={project.data.hero} width="1200" height="760" alt="土族盘绣素材平台系统结构图" loading="lazy" /></div>}
      <span class="home-work__arrow" aria-hidden="true">↗</span>
    </a>)}</div>
    <a class="home-inline-link" href="/projects/">{homeConfig.sections.projectsLinkLabel} <span aria-hidden="true">↗</span></a>
  </section>

  <section id="capabilities" class="home-capabilities" aria-labelledby="capabilities-title">
    <div class="home-capabilities__intro"><p class="eyebrow">FOUR DIMENSIONS</p><h2 id="capabilities-title">方法不止一种，<br />交付始终具体。</h2><p>跨领域的价值，在于能把不同能力接到同一个问题上。</p></div>
    <div class="home-capabilities__layout">
      <div class="home-capabilities__chapters">
        <article class="capability-chapter" data-capability="project"><span class="capability-chapter__number">01 / 项目</span><h3>从问题到现场。</h3><p>把模糊需求拆成可推进的步骤，在真实业务约束下做验证、调整与交付。</p><a href="/projects/">阅读项目案例 ↗</a><div class="capability-chapter__mobile-proof"><b>PROJECT RECORD</b><span>供件达人 · 净界 · 锦绣前程</span></div></article>
        <article class="capability-chapter" data-capability="content"><span class="capability-chapter__number">02 / 内容</span><h3>让信息被看见。</h3><p>参与节目后期与影像表达，用节奏和叙事将复杂信息组织成可以传播的内容。</p><a href="/media/">查看影像作品 ↗</a><div class="capability-chapter__mobile-proof"><b>CREDITED WORK</b><span>品质中国 · 攀登者 · 见解</span></div></article>
        <article class="capability-chapter" data-capability="technology"><span class="capability-chapter__number">03 / 技术</span><h3>把方法写成系统。</h3><p>从需求到前台、管理端、接口与数据结构，让方案变成可运行、可迭代的软件。</p><a href="/capabilities/">查看技术能力 ↗</a><div class="capability-chapter__mobile-proof"><b>FULL-STACK BUILD</b><span>Vue · TypeScript · NestJS · MySQL</span></div></article>
        <article class="capability-chapter" data-capability="research"><span class="capability-chapter__number">04 / 研究</span><h3>留下判断的依据。</h3><p>持续记录问题、资料、实验与复盘，让观点能够追溯，让下一次实践有更好的起点。</p><a href="/articles/">阅读研究与写作 ↗</a><div class="capability-chapter__mobile-proof"><b>PUBLIC NOTES</b><span>方法 · 验证 · 复盘</span></div></article>
      </div>
      <div class="home-capabilities__stage" aria-hidden="true">
        <div class="home-capabilities__stage-head"><span>CAPABILITY INDEX</span><span data-capability-count>01 — 04</span></div>
        <div class="capability-stage__panel is-active" data-capability-panel="project"><span class="stage-giant">01</span><p>问题 / 路径 / 验证 / 交付</p><strong>REAL<br />WORK.</strong></div>
        <div class="capability-stage__panel" data-capability-panel="content"><span class="stage-giant">02</span><div class="stage-credits">{programCredits.map((credit) => <p><b>{credit.series}</b><span>{credit.credit}</span></p>)}</div><strong>STORIES<br />MATTER.</strong></div>
        <div class="capability-stage__panel" data-capability-panel="technology"><span class="stage-giant">03</span><div class="stage-stack"><span>Vue / TypeScript</span><span>NestJS / API</span><span>MySQL / Content</span></div><strong>MAKE IT<br />WORK.</strong></div>
        <div class="capability-stage__panel" data-capability-panel="research"><span class="stage-giant">04</span><p>观察 → 假设 → 验证 → 记录</p><strong>THINK<br />IN PUBLIC.</strong></div>
        <div class="home-capabilities__stage-foot">张智博 <span> / </span> 作品与方法</div>
      </div>
    </div>
  </section>

  <section class="section home-proof" aria-labelledby="records-title">
    <div class="section-heading home-section-heading"><div><p class="eyebrow">PUBLIC RECORD</p><h2 id="records-title">{homeConfig.sections.recordsTitle}</h2></div><p>{homeConfig.sections.recordsCopy}</p></div>
    <div class="home-proof__featured"><div class="home-proof__feature-mark"><span>FEATURED RECORD</span><strong>{featuredAchievement.year}</strong></div><div class="home-proof__feature-copy"><p>{featuredAchievement.kind} / {featuredAchievement.status}</p><h3>{featuredAchievement.title}</h3><span>{featuredAchievement.project} · {featuredAchievement.role}。{featuredAchievement.teamScope}</span><a href={'/achievements/#' + featuredAchievement.id}>查看记录与出处 <span aria-hidden="true">↗</span></a></div></div>
    <div class="home-proof__timeline">{timeline.map((record) => <a href={'/achievements/#' + record.id}><time>{record.year}</time><span>{record.project}</span><b>{record.title}</b><em aria-hidden="true">↗</em></a>)}</div>
    <a class="home-inline-link" href="/achievements/">查看完整成果档案 <span aria-hidden="true">↗</span></a>
  </section>

  <section class="section home-media" aria-labelledby="media-title">
    <div class="section-heading home-section-heading"><div><p class="eyebrow">SELECTED CREDITS</p><h2 id="media-title">镜头之外，也有我的工作。</h2></div><p>按节目原页署名列示，保留制作团队的完整归属。</p></div>
    <div class="home-media__list">{programCredits.map((credit, index) => <a href={credit.href} target="_blank" rel="noopener noreferrer"><span>{String(index + 1).padStart(2, '0')}</span><strong>{credit.series}</strong><small>{credit.credit}</small><em>查看节目署名 ↗</em></a>)}</div>
    <a class="home-inline-link" href="/media/">影像作品与公开资料 <span aria-hidden="true">↗</span></a>
  </section>

  <section class="section home-writing" aria-labelledby="writing-title"><div class="section-heading home-section-heading"><div><p class="eyebrow">NOTES & RESEARCH</p><h2 id="writing-title">{homeConfig.sections.articlesTitle}</h2></div><p>关于技术、产品与实践的持续观察。</p></div><div class="article-list">{articles.map((article, index) => <ArticleCard article={article} featured={index === 0} />)}</div><a class="home-inline-link" href="/articles/">{homeConfig.sections.articlesLinkLabel} <span aria-hidden="true">↗</span></a></section>

  <section class="section home-about" aria-labelledby="about-title"><p class="eyebrow">ABOUT & COLLABORATION</p><div><h2 id="about-title">{homeConfig.sections.aboutTitle.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</h2><div><p>{homeConfig.sections.aboutCopy}</p><a href="mailto:zzb9999@outlook.com?subject=%E9%A1%B9%E7%9B%AE%E5%90%88%E4%BD%9C%E4%BA%A4%E6%B5%81">谈一个项目 <span aria-hidden="true">↗</span></a><a href="/about/">{homeConfig.sections.aboutLinkLabel} <span aria-hidden="true">↗</span></a></div></div></section>

  <section class="section home-faq" aria-labelledby="faq-title"><details><summary id="faq-title">{homeConfig.sections.faqTitle} <span aria-hidden="true">＋</span></summary><div>{faqItems.map((item) => <details><summary>{item.question}<span aria-hidden="true">＋</span></summary><p>{item.answer}</p></details>)}</div></details></section>
  <script>import '../scripts/home-motion';</script>
</BaseLayout>
