---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { achievementSummary, faqItems, siteProfile } from '../data/site';
import { homeConfig } from '../data/workbench';
import '../styles/home-page.css';

const allProjects = await getCollection('projects');
const projects = homeConfig.featuredProjectSlugs.map((slug) => allProjects.find((project) => project.data.slug === slug)).filter((project): project is NonNullable<typeof project> => Boolean(project));
const allArticles = (await getCollection('articles')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const articles = homeConfig.featuredArticleSlugs.length > 0
  ? homeConfig.featuredArticleSlugs.map((slug) => allArticles.find((article) => article.data.slug === slug)).filter((article): article is NonNullable<typeof article> => Boolean(article)).slice(0, 3)
  : allArticles.slice(0, 3);
const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteProfile.siteName,
  alternateName: siteProfile.brandName,
  url: Astro.site,
  description: siteProfile.description,
  inLanguage: 'zh-CN',
  author: { '@id': new URL('/#person', Astro.site).href },
}, {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
}];
---
<BaseLayout title="张智博个人官网｜项目、成果与思考" description={siteProfile.description} structuredData={structuredData} isHome preloadImages={[{ href: '/images/hero/desktop-hero-background.webp', media: '(min-width: 761px)' }, { href: '/images/hero/mobile-hero-background.webp', media: '(max-width: 760px)' }]}>
  <meta slot="head" name="shenma-site-verification" content="1f22379207ad6c540ae8ecd788cafeff_1785080201" />
  <section class="hero hero--editorial" aria-labelledby="home-title">
    <div class="hero__guide" aria-hidden="true"><span></span></div>
    <div class="hero__content">
      <h1 id="home-title">{homeConfig.hero.name}</h1>
      <p class="hero-subtitle">{homeConfig.hero.subtitle}</p>
      <p class="hero-copy">{homeConfig.hero.copy}</p>
      <div class="hero-links"><a href="/projects/">{homeConfig.hero.projectsLabel} <i>→</i></a><a href="/articles/">{homeConfig.hero.articlesLabel} <i>→</i></a></div>
    </div>
    <a class="hero__scroll" href="#selected-work" aria-label="向下查看项目"><span></span></a>
    <div class="hero__transition" aria-hidden="true"></div>
  </section>

  <section id="selected-work" class="section" aria-labelledby="selected-work-title">
    <div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2 id="selected-work-title">{homeConfig.sections.projectsTitle}</h2></div><p>{homeConfig.sections.projectsCopy}</p></div>
    <div class="project-grid project-grid--home">{projects.map((project, index) => <ProjectCard project={project} featured={index === 0} eager={index === 0} />)}</div>
    <a class="text-link" href="/projects/">{homeConfig.sections.projectsLinkLabel} <i>→</i></a>
  </section>

  <section class="section evidence" aria-labelledby="records-title">
    <div class="evidence__heading"><div><p class="eyebrow">SELECTED RECORDS</p><h2 id="records-title">{homeConfig.sections.recordsTitle}</h2></div><p>{homeConfig.sections.recordsCopy}</p></div>
    <div class="evidence-grid" data-home-rail="records">{achievementSummary.map((item, index) => <a href={item.href}><em aria-hidden="true">{String(index + 1).padStart(2, '0')}</em><span>{item.label}</span><strong>{item.value}</strong><p>{item.copy}</p><b>查看对应记录 <i>→</i></b></a>)}</div>
    <nav class="home-rail-dots" aria-label="成果记录分页" data-home-rail-dots="records">{achievementSummary.map((item, index) => <button type="button" aria-label={`查看第 ${index + 1} 项成果：${item.label}`} aria-current={index === 0 ? 'true' : undefined}></button>)}</nav>
  </section>

  <section class="section articles-preview" aria-labelledby="writing-title">
    <div class="section-heading"><div><p class="eyebrow">WRITING</p><h2 id="writing-title">{homeConfig.sections.articlesTitle}</h2></div><a class="text-link" href="/articles/">{homeConfig.sections.articlesLinkLabel} <i>→</i></a></div>
    <div class="article-list" data-home-rail="articles">{articles.map((article, index) => <ArticleCard article={article} featured={index === 0} />)}</div>
    <nav class="home-rail-dots" aria-label="最新文章分页" data-home-rail-dots="articles">{articles.map((article, index) => <button type="button" aria-label={`查看第 ${index + 1} 篇文章：${article.data.title}`} aria-current={index === 0 ? 'true' : undefined}></button>)}</nav>
  </section>

  <section class="section about-teaser"><p class="eyebrow">ABOUT</p><h2>{homeConfig.sections.aboutTitle.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</h2><p>{homeConfig.sections.aboutCopy}</p><a class="text-link" href="/about/">{homeConfig.sections.aboutLinkLabel} <i>→</i></a></section>

  <section class="section faq faq--reference" aria-labelledby="faq-title">
    <div class="faq-reference__heading"><h2 id="faq-title">{homeConfig.sections.faqTitle}</h2></div>
    <div class="faq-list faq-reference__list">
      {faqItems.map((item) => <details>
        <summary><span>{item.question}</span><img src="https://api.iconify.design/tabler/plus.svg?color=%23e8a44c" width="28" height="28" alt="" aria-hidden="true" /></summary>
        <p>{item.answer}</p>
      </details>)}
    </div>
  </section>
  <script>
    document.querySelectorAll<HTMLElement>('[data-home-rail-dots]').forEach((dots) => {
      const railName = dots.dataset.homeRailDots;
      const track = railName ? document.querySelector<HTMLElement>(`[data-home-rail="${railName}"]`) : null;
      const cards = track ? Array.from(track.children) as HTMLElement[] : [];
      const buttons = Array.from(dots.querySelectorAll<HTMLButtonElement>('button'));
      if (!track || cards.length !== buttons.length) return;

      const cardScrollLeft = (card: HTMLElement) => card.offsetLeft - parseFloat(getComputedStyle(track).paddingLeft || '0');
      const sync = () => {
        dots.hidden = track.scrollWidth <= track.clientWidth + 1;
        const activeIndex = cards.reduce((closestIndex, card, index) => (
          Math.abs(cardScrollLeft(card) - track.scrollLeft) < Math.abs(cardScrollLeft(cards[closestIndex]) - track.scrollLeft) ? index : closestIndex
        ), 0);
        buttons.forEach((button, index) => {
          if (index === activeIndex) button.setAttribute('aria-current', 'true');
          else button.removeAttribute('aria-current');
        });
      };

      buttons.forEach((button, index) => button.addEventListener('click', () => track.scrollTo({ left: cardScrollLeft(cards[index]), behavior: 'smooth' })));
      track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
      new ResizeObserver(sync).observe(track);
      sync();
    });
  </script>
</BaseLayout>
