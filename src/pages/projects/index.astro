---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectOrder } from '../../data/project-page';
import '../../styles/projects-store.css';
const allProjects = await getCollection('projects');
const projects = projectOrder.map(slug => allProjects.find(project => project.data.slug === slug)).filter((project): project is NonNullable<typeof project> => Boolean(project));
const featuredSlugs = ['postal-sorting-robot', 'jingjie', 'xianyu-feishu-tool'];
const featured = featuredSlugs.map(slug => projects.find(project => project.data.slug === slug)).filter((project): project is NonNullable<typeof project> => Boolean(project));
const structuredData = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: '张智博的项目', url: new URL('/projects/', Astro.site).href, mainEntity: { '@type': 'ItemList', itemListElement: projects.map((project, index) => ({ '@type': 'ListItem', position: index + 1, name: project.data.title, url: new URL('/projects/' + project.data.slug + '/', Astro.site).href })) } };
---
<BaseLayout title="张智博项目作品｜AI 应用、智能机器人与创新实践" description="记录 AI 应用、智能设备、产品创新与增长实践中的问题、个人职责和阶段成果。" structuredData={structuredData}>
  <div class="projects-store-page">
    <header class="page-hero projects-intro"><p class="eyebrow">PROJECTS</p><h1>项目与实践</h1><p>从智能设备到日常工具，记录具体问题、承担的工作和留下的成果。</p><a class="text-link" href="#project-showcase">浏览全部 {projects.length} 个项目 <span aria-hidden="true">↓</span></a></header>
    <section class="project-selection" aria-labelledby="selected-projects-title"><div class="section-heading"><h2 id="selected-projects-title">精选项目</h2><p>智能设备、产品创新与流程自动化。</p></div><div class="selected-projects">{featured.map(project => <ProjectCard project={project} eager />)}</div></section>
    <section id="project-showcase" class="project-directory" aria-labelledby="project-showcase-title"><div class="section-heading"><h2 id="project-showcase-title">全部项目</h2><p>{projects.length} 项实践 · 持续更新</p></div><div class="project-directory__list">{projects.map(project => <a class="project-directory__item" href={'/projects/' + project.data.slug + '/'}><span>{project.data.category}<small>{project.data.year}</small></span><div><h3>{project.data.title}</h3><p>{project.data.summary}</p><p class="project-directory__role">本人职责 · {project.data.role}</p></div><span class="project-directory__arrow" aria-hidden="true">↗</span></a>)}</div></section>
    <section class="projects-closing"><h2>项目之外的记录</h2><p>公开成果、实践中的思考，以及仍在探索的问题。</p><div><a class="text-link" href="/achievements/">成果与荣誉 →</a><a class="text-link" href="/articles/">阅读文章 →</a><a class="text-link" href="mailto:zzb9999@outlook.com">联系我 →</a></div></section>
  </div>
</BaseLayout>
